NODE_ENV=development
PORT=3000
DEMO_MODE=true

# Slack app credentials. Demo HTTP mode works without these.
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-token-for-socket-mode
SLACK_SOCKET_MODE=true
# Required Slack app scopes for Assistant thread API:
# assistant:write, im:history, im:read, im:write, chat:write
# Enable "Agents & AI Apps" feature in your Slack app settings

# Slack Real-Time Search API (xoxp user token with search:read scope)
# When set, CrisisOps uses live Slack search instead of demo data
SLACK_USER_TOKEN=xoxp-your-user-token-here

# Future real integrations
SLACK_RTS_API_TOKEN=your-rts-token-here
MCP_GATEWAY_URL=

# Groq LLM — used for AI-generated briefings and postmortems
# Get a free key at https://console.groq.com

